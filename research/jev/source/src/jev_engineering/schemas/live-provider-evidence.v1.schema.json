{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/live-provider-evidence.v1.schema.json",
  "title": "Aftergraph Live Provider Evidence Bundle v1",
  "type": "object",
  "required": ["version", "execution", "signed_executions", "signer_key_id", "campaign_sha256", "live_provider_measurement", "truth_boundary"],
  "properties": {
    "version": {"const": 1},
    "execution": {"type": "object"},
    "signed_executions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "signer_key_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "live_provider_measurement": {"type": "boolean"},
    "truth_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
