{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aftergraph://schemas/runner-sealed-secrets.v1",
  "type": "object",
  "required": ["schema","key_fingerprint_sha256","ciphertexts"],
  "properties": {
    "schema": {"const":"aftergraph.runner-sealed-secrets/1.0"},
    "key_fingerprint_sha256": {"type":"string","minLength":64,"maxLength":64},
    "ciphertexts": {
      "type":"object",
      "propertyNames":{"enum":["TYPESAFE_API_KEY","DIALAGRAM_API_KEY"]},
      "additionalProperties":{"type":"string","minLength":1}
    }
  },
  "additionalProperties": false
}