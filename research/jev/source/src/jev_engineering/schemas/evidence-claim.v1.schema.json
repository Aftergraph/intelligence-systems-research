{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/evidence-claim.v1.schema.json",
  "title": "Aftergraph EvidenceClaim v1",
  "type": "object",
  "required": ["claim_id", "subject", "predicate", "verifier", "method", "verdict", "dependencies", "parent_claim_ids"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "verdict": {"type": "boolean"},
    "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
    "parent_claim_ids": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "number"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
