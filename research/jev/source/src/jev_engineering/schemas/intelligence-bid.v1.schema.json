{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/intelligence-bid.v1.schema.json",
  "title": "Aftergraph IntelligenceBid v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "source", "capabilities", "predicted_vsr", "estimated_cost_usd", "estimated_latency_ms", "authorized"],
  "properties": {
    "strategy_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["rule", "jev", "ml", "small_model", "frontier", "specialist", "team", "human"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "predicted_vsr": {"type": "number", "minimum": 0, "maximum": 1},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "estimated_latency_ms": {"type": "number", "minimum": 0},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "risk": {"type": "number", "minimum": 0, "maximum": 1},
    "frontier_input_tokens": {"type": "integer", "minimum": 0},
    "frontier_output_tokens": {"type": "integer", "minimum": 0},
    "authorized": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}
