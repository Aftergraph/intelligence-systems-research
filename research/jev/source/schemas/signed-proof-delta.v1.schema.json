{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/signed-proof-delta.v1.schema.json",
  "title": "Aftergraph SignedProofDelta v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "key_id", "algorithm", "payload_sha256", "signature_b64"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["kind", "graph_id", "base_revision", "claims"],
      "properties": {
        "kind": {"const": "aftergraph.proof-delta/v1"},
        "graph_id": {"type": "string", "minLength": 1},
        "base_revision": {"type": "integer", "minimum": 0},
        "claims": {"type": "array", "items": {"type": "object"}}
      }
    },
    "key_id": {"type": "string", "minLength": 1},
    "algorithm": {"const": "Ed25519"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_b64": {"type": "string", "minLength": 1}
  }
}
