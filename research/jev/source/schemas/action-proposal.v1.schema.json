{
  "$id": "https://aftergraph.org/schemas/action-proposal.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "type": "string"
    },
    "expected_effect": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "file_write"
    },
    "preimage_sha256": {
      "minLength": 1,
      "type": "string"
    },
    "proposed_sha256": {
      "minLength": 1,
      "type": "string"
    },
    "reversible": {
      "type": "boolean"
    },
    "target": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "action_id",
    "kind",
    "target",
    "expected_effect",
    "reversible",
    "preimage_sha256",
    "proposed_sha256"
  ],
  "title": "Aftergraph ActionProposal v1",
  "type": "object"
}
