{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/relay-hub-config.v1.schema.json",
  "title": "Aftergraph Relay Hub Config v1",
  "type": "object",
  "required": [
    "host",
    "port",
    "ca_file",
    "certificate_file",
    "private_key_file",
    "allowed_node_ids",
    "allowed_coordinator_ids"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ca_file": {
      "type": "string",
      "minLength": 1
    },
    "certificate_file": {
      "type": "string",
      "minLength": 1
    },
    "private_key_file": {
      "type": "string",
      "minLength": 1
    },
    "allowed_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_coordinator_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "call_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "generation_store_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
