[Unit]
Description=Aftergraph Jev Outbound Relay Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aftergraph
Group=aftergraph
WorkingDirectory=/var/lib/aftergraph-relay
ExecStart=/opt/aftergraph-jev/bin/jev-one relay-hub-serve /etc/aftergraph/relay-hub.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/aftergraph

[Install]
WantedBy=multi-user.target
