{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aftergraph.research.verge-headroom-trace.v1",
  "title": "VERGE Headroom fixed-label execution trace",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "workload_id",
    "confidence_threshold",
    "verification_depth",
    "retry_ceiling",
    "min_confidence",
    "min_verification",
    "min_retries",
    "verified_success",
    "false_completion",
    "unauthorized_actions",
    "evidence_integrity_failures",
    "cost",
    "latency",
    "human_interventions",
    "source_artifact",
    "source_hash"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "workload_id": {"type": "string", "minLength": 1},
    "confidence_threshold": {"type": "number"},
    "verification_depth": {"type": "integer", "minimum": 0},
    "retry_ceiling": {"type": "integer", "minimum": 0},
    "min_confidence": {"type": "number"},
    "min_verification": {"type": "integer", "minimum": 0},
    "min_retries": {"type": "integer", "minimum": 0},
    "verified_success": {"type": "integer", "enum": [0, 1]},
    "false_completion": {"type": "integer", "enum": [0, 1]},
    "unauthorized_actions": {"type": "integer", "minimum": 0},
    "evidence_integrity_failures": {"type": "integer", "minimum": 0},
    "cost": {"type": "number", "minimum": 0},
    "latency": {"type": "number", "minimum": 0},
    "human_interventions": {"type": "integer", "minimum": 0},
    "source_artifact": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "minLength": 1}
  }
}
