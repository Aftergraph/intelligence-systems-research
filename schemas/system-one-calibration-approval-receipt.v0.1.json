{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/system-one-calibration-approval-receipt.v0.1.json",
  "title": "Aftergraph System One Calibration Approval Receipt v0.1",
  "description": "Evidence of external authorization for a bounded calibration run. It records authority; it does not create authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "approved",
    "network_calls_authorized",
    "requested_typesafe_model",
    "calibration_manifest_sha256",
    "max_cost_usd",
    "max_provider_calls",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "aftergraph.system-one-calibration-approval/0.1"
    },
    "experiment_id": {
      "const": "JAR-EXP-0014"
    },
    "approved": {
      "const": true
    },
    "network_calls_authorized": {
      "const": true
    },
    "requested_typesafe_model": {
      "type": "string",
      "minLength": 1
    },
    "max_cost_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_provider_calls": {
      "type": "integer",
      "minimum": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "calibration_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
