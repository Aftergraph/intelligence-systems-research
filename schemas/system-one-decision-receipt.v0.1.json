{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/system-one-decision-receipt.v0.1.json",
  "title": "Aftergraph System One Decision Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "mission_id",
    "decision_type",
    "state_sha256",
    "question_contract_sha256",
    "model",
    "answer",
    "routing",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "aftergraph.system-one-decision/0.1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "route_model",
        "route_tool_family",
        "continue_loop",
        "result_sufficient",
        "needs_human",
        "risk_level",
        "retryable_failure",
        "evidence_conflict"
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "requested_model", "returned_model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "returned_model": {"type": "string", "minLength": 1}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "confidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["noul", "choice", "score"]
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distribution": {
          "type": ["object", "array", "null"]
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "fallback_used", "authority_bypassed"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accept", "fallback", "escalate"]
        },
        "fallback_used": {"type": "boolean"},
        "fallback_reason": {
          "type": ["string", "null"]
        },
        "authority_bypassed": {
          "const": false
        }
      }
    },
    "latency_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "cost_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "generated_at"],
      "properties": {
        "source_commit": {
          "type": "string",
          "minLength": 7
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
